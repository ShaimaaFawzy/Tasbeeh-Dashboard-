# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tasbeeh?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API Documentation (Swagger)
ENABLE_SWAGGER=true
API_BASE_URL=http://localhost:3000
API_TITLE=Tasbeeh API Documentation
API_VERSION=1.0.0
